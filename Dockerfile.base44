# Base44 dev image for this notebook-based repo.
# Installs the Python scientific + Jupyter stack only; source is bind-mounted at runtime.
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
        jupyterlab \
        numpy \
        pandas \
        matplotlib \
        seaborn \
        scikit-learn \
        ipykernel \
        pygame

WORKDIR /work
